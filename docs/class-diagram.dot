digraph G { graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.6", label="Bank Transaction API - Class Diagram", labelloc=t, fontsize=20, fontname="Arial"]; node [shape=record, style="rounded,filled", fillcolor="#f8fafc", color="#64748b", fontname="Arial", fontsize=9]; edge [fontname="Arial", fontsize=9, color="#475569"]; Customer [label="{Customer|id: Long\lfullName: String\lcustomerType: CustomerType\ljoinedDate: LocalDate\l}"]; Account [label="{Account|id: Long\laccountNumber: String\l}"]; Transaction [label="{Transaction|id: Long\ltransactionType: TransactionType\lamount: BigDecimal\ldiscountAmount: BigDecimal\lchargedAmount: BigDecimal\lcreatedAt: LocalDateTime\l}"]; AuditLog [label="{AuditLog|id: Long\lmethod: String\lpath: String\lstatusCode: int\loccurredAt: LocalDateTime\l}"]; DiscountRule [label="{DiscountRule interface|discountRate(...): BigDecimal}",fillcolor="#e0f2fe"]; BusinessRule [label="{BusinessCustomerDiscountRule}"]; RetailRule [label="{RetailCustomerDiscountRule}"]; TenureRule [label="{LongTenureDiscountRule}"]; Calculator [label="{DiscountCalculator|calculate(...): BigDecimal}"]; Controller [label="{TransactionController|transfer(...)\lairtime(...)\lhistory(...)}"]; Service [label="{TransactionService|transfer(...)\lairtime(...)\lhistory(...)}"]; Repos [label="{Repository interfaces|CustomerRepository\lAccountRepository\lTransactionRepository\lAuditLogRepository\l}"]; Types [label="{Enums|CustomerType: RETAIL, BUSINESS\lTransactionType: TRANSFER, AIRTIME\lNetworkProvider: MTN, AIRTEL, GLO, NINE_MOBILE\l}"]; Customer -> Account [label="owns 1 to 1..*"]; Account -> Transaction [label="source 1 to 0..*"]; Account -> Transaction [label="destination 0..1 to 0..*",style=dashed]; DiscountRule -> BusinessRule [arrowhead=empty]; DiscountRule -> RetailRule [arrowhead=empty]; DiscountRule -> TenureRule [arrowhead=empty]; Calculator -> DiscountRule [label="uses 1..*"]; Controller -> Service; Service -> Repos; Service -> Calculator; }