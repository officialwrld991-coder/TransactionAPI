digraph G { graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.7", label="Bank Transaction API — Use Case Diagram", labelloc=t, fontsize=20, fontname="Arial"]; node [fontname="Arial", fontsize=11]; edge [fontname="Arial", fontsize=10]; customer [shape=plaintext,label="Customer"]; retail [shape=plaintext,label="Retail Customer"]; business [shape=plaintext,label="Business Customer"]; subgraph cluster_api { label="Bank Transaction API"; fontsize=14; style=rounded; color="#64748b"; transfer [shape=ellipse,label="Do Transfer"]; airtime [shape=ellipse,label="Buy Airtime"]; history [shape=ellipse,label="View Transaction History"]; discount [shape=ellipse,label="Apply Discount"]; audit [shape=ellipse,label="Record Audit"]; } retail -> customer [arrowhead=empty]; business -> customer [arrowhead=empty]; customer -> transfer; customer -> airtime; customer -> history; transfer -> discount [style=dashed,label="<<include>>"]; transfer -> audit [style=dashed,label="<<include>>"]; airtime -> audit [style=dashed,label="<<include>>"]; history -> audit [style=dashed,label="<<include>>"]; }